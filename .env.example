DATABASE_URL="file:./dev.db"

# TMDB "API Read Access Token" (v4 auth, sent as Bearer). Server-side only: never prefix with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=""

# Production origin for canonical URLs, Open Graph, sitemap.xml and robots.txt (read at build time).
# Unset: Vercel's production domain on Vercel, http://localhost:3000 elsewhere.
NEXT_PUBLIC_SITE_URL=""

