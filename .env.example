DATABASE_URL="file:./dev.db"

# TMDB "API Read Access Token" (v4 auth, sent as Bearer). Server-side only: never prefix with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=""

# Production origin for canonical URLs, Open Graph, sitemap.xml and robots.txt (read at build time).
# Unset: Vercel's production domain on Vercel, http://localhost:3000 elsewhere.
NEXT_PUBLIC_SITE_URL=""

# Production build only (see README, "Production data"): DATABASE_URL="file:./.data/catalog.db",
# plus the private URL of the snapshot made by `npm run db:snapshot` and its bearer token, if any.
# The snapshot holds TMDB content: never commit it or make it public.
CATALOG_DB_URL=""
CATALOG_DB_TOKEN=""
